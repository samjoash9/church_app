# Copy to .env and fill in real values. Never commit .env.

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Generate: python -c "import hashlib; print(hashlib.sha256(b'yourpassword').hexdigest())"
APP_PASSWORD_HASH=

# --- Database ---
# Supabase Postgres connection string. Leave EMPTY to use a local SQLite file
# (dev). Get from Supabase -> Project Settings -> Database -> Connection string.
#   postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=

# --- Split deploy (Vercel frontend + Render API) ---
# Comma-separated frontend origins allowed to call the API (your Vercel URL).
# e.g. https://church-app.vercel.app
ALLOWED_ORIGINS=
# Public origin of THIS API, used to build absolute /media/assets URLs for the
# cross-origin frontend. e.g. https://church-api.onrender.com
PUBLIC_MEDIA_BASE=

# Session cookie flags. Cross-site (split deploy) REQUIRES none + true.
# Local http dev: samesite=lax, secure=false.
COOKIE_SAMESITE=none
COOKIE_SECURE=true

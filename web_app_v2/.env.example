# Copy to .env and fill in real values. Never commit .env.

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Generate: python -c "import hashlib; print(hashlib.sha256(b'yourpassword').hexdigest())"
APP_PASSWORD_HASH=

# Comma-separated frontend origins allowed to call the API. Leave EMPTY when
# the backend serves the built frontend itself (same-origin — no CORS needed).
# Only set for a separately-hosted frontend, e.g. https://church-app.example.com
ALLOWED_ORIGINS=

# Copy to .env for local, or set in the Vercel project's Environment Variables.
# Origin of the backend API (Render). Leave UNSET for local dev — the Vite
# proxy forwards /api and /media to 127.0.0.1:8000 (same-origin).
# Prod example:
# VITE_API_BASE=https://church-api.onrender.com
VITE_API_BASE=
